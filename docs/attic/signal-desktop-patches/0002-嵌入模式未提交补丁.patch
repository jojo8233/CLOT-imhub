index 0000000..dfbb3a3
--- /dev/null
+++ b/app/imhub_embed.main.ts
@@ -0,0 +1,151 @@
+// Copyright 2026 im-hub
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+// im-hub 补丁：嵌入模式（「窗口覆盖」方案）。
+//
+// 为什么不是真正的内嵌：Signal Desktop 的整个客户端跑在渲染层的 preload 里，
+// 依赖 sqlcipher / libsignal 这些原生模块，没法被别的 Electron 应用用 webview
+// 装进去；macOS 又没有 Windows SetParent() 那种跨进程窗口重父化的手段。
+//
+// 所以这里的做法是：Signal 仍然是独立进程、独立窗口，但去掉边框、禁止用户自己
+// 拖动，位置/大小/层级全部交给宿主 im-hub 实时同步，精确贴在宿主内容区上，
+// 视觉上就是一个应用。代价是焦点切换和多显示器场景会有瑕疵——这是这条路
+// 已知的上限，换来的是不用动 Signal 主进程的账号模型。
+//
+// 只在 IM_HUB_EMBED_SOCKET 存在时启用；不设这个变量时本文件全程无副作用，
+// Signal 照常独立运行。
+
+import { connect } from 'node:net';
+import type { Socket } from 'node:net';
+import type { BrowserWindow } from 'electron';
+
+import { createLogger } from '../ts/logging/log.std.ts';
+
+const log = createLogger('imhub-embed');
+
+const socketPath = process.env.IM_HUB_EMBED_SOCKET;
+const handshakeToken = process.env.IM_HUB_EMBED_TOKEN;
+
+export function isImHubEmbed(): boolean {
+  return Boolean(socketPath);
+}
+
+/**
+ * 嵌入模式下要盖掉的 BrowserWindow 选项。
+ *
+ * `show: false` 是关键：宿主还没告诉我们该贴在哪之前先别露面，否则会先在默认
+ * 位置闪一下无边框窗口。真正的显示由宿主的 show 指令触发。
+ */
+export function imHubEmbedWindowOptions(): Electron.BrowserWindowConstructorOptions {
+  return {
+    show: false,
+    frame: false,
+    titleBarStyle: 'default',
+    movable: false,
+    resizable: false,
+    minimizable: false,
+    maximizable: false,
+    fullscreenable: false,
+    skipTaskbar: true,
+    // 宿主会把我们精确摆到内容区，Signal 自己的最小尺寸限制会顶掉宿主给的
+    // 尺寸，导致右边/下边溢出到宿主窗口外面。
+    minWidth: 0,
+    minHeight: 0,
+  };
+}
+
+type HostCommand =
+  | { t: 'bounds'; x: number; y: number; width: number; height: number }
+  | { t: 'show' }
+  | { t: 'hide' }
+  | { t: 'top'; v: boolean }
+  | { t: 'focus' }
+  | { t: 'quit' };
+
+/**
+ * 连上宿主，开始接受它的摆布，并把自己的焦点变化报回去。
+ *
+ * 宿主需要知道我们有没有被点中：用户点 Signal 窗口时宿主自己的窗口会失焦，
+ * 宿主分不清是「切到别的 App 了」还是「点到我托管的 Signal 上了」，只能靠
+ * 我们主动上报。
+ */
+export function attachImHubEmbed(win: BrowserWindow): void {
+  if (!socketPath) return;
+
+  let sock: Socket | undefined;
+  const send = (msg: unknown): void => {
+    sock?.write(`${JSON.stringify(msg)}\n`);
+  };
+
+  const apply = (cmd: HostCommand): void => {
+    if (win.isDestroyed()) return;
+    switch (cmd.t) {
+      case 'bounds':
+        win.setBounds({
+          x: Math.round(cmd.x),
+          y: Math.round(cmd.y),
+          width: Math.round(cmd.width),
+          height: Math.round(cmd.height),
+        });
+        break;
+      case 'show':
+        // showInactive：宿主刚被点中时不要把焦点抢过来，否则用户点宿主侧边栏
+        // 会变成焦点在宿主和 Signal 之间来回弹。
+        if (!win.isVisible()) win.showInactive();
+        break;
+      case 'hide':
+        if (win.isVisible()) win.hide();
+        break;
+      case 'top':
+        win.setAlwaysOnTop(cmd.v, 'floating');
+        break;
+      case 'focus':
+        win.focus();
+        break;
+      case 'quit':
+        win.destroy();
+        break;
+      default:
+        break;
+    }
+  };
+
+  const onLine = (line: string): void => {
+    if (!line.trim()) return;
+    try {
+      apply(JSON.parse(line) as HostCommand);
+    } catch (error) {
+      log.warn('无法解析宿主指令', error);
+    }
+  };
+
+  sock = connect(socketPath, () => {
+    log.info('已连上 im-hub 宿主');
+    send({ t: 'hello', token: handshakeToken });
+    send({ t: 'ready' });
+  });
+
+  let buffer = '';
+  sock.on('data', chunk => {
+    buffer += chunk.toString('utf8');
+    let index = buffer.indexOf('\n');
+    while (index !== -1) {
+      onLine(buffer.slice(0, index));
+      buffer = buffer.slice(index + 1);
+      index = buffer.indexOf('\n');
+    }
+  });
+
+  // 宿主没了就别继续飘着一个没有边框、用户关不掉的窗口。
+  sock.on('close', () => {
+    log.warn('与 im-hub 宿主的连接断开，退出');
+    if (!win.isDestroyed()) win.destroy();
+  });
+  sock.on('error', error => {
+    log.error('宿主连接出错', error);
+  });
+
+  win.on('focus', () => send({ t: 'focus' }));
+  win.on('blur', () => send({ t: 'blur' }));
+  win.on('closed', () => sock?.end());
+}
