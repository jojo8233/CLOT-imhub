+// im-hub 补丁：气泡内的译文块。原文在上、横线分隔、译文在下，出入站都渲染。
+//
+// Signal 没有任何内建翻译流水线（telegram-tt 有、我们只是换了译文来源），
+// 所以这里自带一个模块级缓存：同一条消息滚动进出视口、重渲染多少次，
+// 都只翻一次。缓存按消息 id + 文本联合键——消息被编辑后文本变了要重翻。
+
+import React, { useEffect, useState } from 'react';
+import { isImHubTranslationEnabled, translateOne } from '../../util/imhub.dom.ts';
+
+const TARGET_LANG = 'zh';
+
+/**
+ * value 为 null 表示「翻过了，译文与原文相同或失败」——同样不再重试。
+ * 失败也记下来是刻意的：一条消息翻不动就别每次重渲染都打一遍服务端。
+ */
+const cache = new Map<string, string | null>();
+const inFlight = new Map<string, Promise<string | null>>();
+
+async function translateCached(key: string, text: string): Promise<string | null> {
+  const hit = cache.get(key);
+  if (hit !== undefined) {
+    return hit;
+  }
+  const pending = inFlight.get(key);
+  if (pending) {
+    return pending;
+  }
+
+  const task = (async () => {
+    const translated = await translateOne(text, TARGET_LANG);
+    const result = translated && translated.trim() !== text.trim() ? translated : null;
+    cache.set(key, result);
+    inFlight.delete(key);
+    return result;
+  })();
+  inFlight.set(key, task);
+  return task;
+}
+
+export type PropsType = {
+  messageId: string;
+  text: string;
+};
+
+export function ImHubTranslation({ messageId, text }: PropsType): React.JSX.Element | null {
+  const [translated, setTranslated] = useState<string | null>(() => {
+    const hit = cache.get(`${messageId}:${text}`);
+    return hit ?? null;
+  });
+
+  useEffect(() => {
+    if (!isImHubTranslationEnabled() || !text.trim()) {
+      return undefined;
+    }
+    let cancelled = false;
+    void translateCached(`${messageId}:${text}`, text).then(result => {
+      if (!cancelled) {
+        setTranslated(result);
+      }
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [messageId, text]);
+
+  if (!translated) {
+    return null;
+  }
+
+  return (
+    <div className="ImHubTranslation" dir="auto">
+      {translated}
+    </div>
+  );
+}
