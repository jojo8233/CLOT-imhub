diff --git a/ts/util/imhub.dom.ts b/ts/util/imhub.dom.ts
new file mode 100644
index 0000000..e46ad1a
--- /dev/null
+++ b/ts/util/imhub.dom.ts
@@ -0,0 +1,103 @@
+// im-hub 补丁：与 im-hub 服务端的对接层。
+//
+// 从 telegram-tt fork 的同名模块移植。配置来源不同：telegram-tt 是网页、由
+// webview 注入 window.__IM_HUB__；Signal 是独立 Electron 应用，配置由启动时的
+// 环境变量经 preload（contextBridge）暴露成 window.ImHub。
+//
+// 拿不到配置就静默降级成不翻译，绝不抛错——翻译挂了不该影响 Signal 本体。
+
+export interface ImHubConfig {
+  serverUrl: string;
+  token: string;
+}
+
+interface BatchResult {
+  translated: string;
+  detectedLang: string;
+  provider: string;
+  failed: boolean;
+}
+
+export function getImHubConfig(): ImHubConfig | undefined {
+  const cfg = (window as { ImHub?: ImHubConfig }).ImHub;
+  if (!cfg?.serverUrl || !cfg.token) {
+    return undefined;
+  }
+  return cfg;
+}
+
+export function isImHubTranslationEnabled(): boolean {
+  return getImHubConfig() !== undefined;
+}
+
+export async function translateBatch(
+  texts: ReadonlyArray<string>,
+  targetLang: string
+): Promise<ReadonlyArray<BatchResult> | undefined> {
+  const cfg = getImHubConfig();
+  if (!cfg) {
+    return undefined;
+  }
+
+  try {
+    const res = await fetch(`${cfg.serverUrl}/api/translate/batch`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: `Bearer ${cfg.token}`,
+      },
+      body: JSON.stringify({ texts, targetLang }),
+      signal: AbortSignal.timeout(30_000),
+    });
+    if (!res.ok) {
+      return undefined;
+    }
+    const body = (await res.json()) as { results?: Array<BatchResult> };
+    return body.results;
+  } catch {
+    return undefined;
+  }
+}
+
+export async function translateOne(
+  text: string,
+  targetLang: string
+): Promise<string | undefined> {
+  const results = await translateBatch([text], targetLang);
+  const first = results?.[0];
+  if (!first || first.failed || !first.translated) {
+    return undefined;
+  }
+  return first.translated;
+}
+
+export async function detectLanguageViaImHub(
+  text: string
+): Promise<string | undefined> {
+  const cfg = getImHubConfig();
+  if (!cfg || !text.trim()) {
+    return undefined;
+  }
+  try {
+    const res = await fetch(`${cfg.serverUrl}/api/translate/detect`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Authorization: `Bearer ${cfg.token}`,
+      },
+      body: JSON.stringify({ text }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!res.ok) {
+      return undefined;
+    }
+    const body = (await res.json()) as { detectedLang?: string | null };
+    const lang = body.detectedLang;
+    if (!lang || lang.toLowerCase() === 'und') {
+      return undefined;
+    }
+    return lang.toLowerCase();
+  } catch {
+    return undefined;
+  }
+}
