+// im-hub 补丁：把翻译服务的地址与登录态暴露给渲染层。
+// 来源是启动 Signal 时传入的环境变量（由 im-hub 负责拉起进程时注入）。
+// 没配就不暴露，渲染层据此静默关闭翻译，Signal 本体完全不受影响。
+if (process.env.IM_HUB_SERVER_URL && process.env.IM_HUB_TOKEN) {
+  contextBridge.exposeInMainWorld('ImHub', {
+    serverUrl: process.env.IM_HUB_SERVER_URL,
+    token: process.env.IM_HUB_TOKEN,
+  });
+}
