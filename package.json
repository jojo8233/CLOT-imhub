{
  "name": "im-hub",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:server": "pnpm --filter @im-hub/server dev",
    "dev:desktop": "pnpm --filter @im-hub/desktop dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "db:migrate": "pnpm --filter @im-hub/server migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.0"
  }
}
