DATABASE_URL=postgres://imhub:imhub_dev@localhost:5432/imhub
REDIS_URL=redis://localhost:6379
# 必须替换：openssl rand -base64 32
JWT_SECRET=change-me-in-production
DEEPL_API_KEY=
# 付费账号改成 https://api.deepl.com/v2/translate
DEEPL_ENDPOINT=https://api-free.deepl.com/v2/translate
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_TRANSLATION_PROVIDER=deepl
TDLIB_DATA_DIR=./data/tdlib
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 逗号分隔的内部账号 UUID；默认空。仅在 M3-5 门槛通过后逐账号开启 TDLib shadow-only。
TELEGRAM_TDLIB_SHADOW_ACCOUNT_IDS=
# Signal 首检点使用 signal-cli JSON-RPC；可执行文件不在 PATH 时填写绝对路径。
SIGNAL_CLI_BINARY=signal-cli
SIGNAL_DATA_DIR=./data/signal
# WhatsApp Business Platform Cloud API。全部填好后再改为 true；token 由 Embedded Signup
# 交换后加密存入服务端 secret store，不在这里填写，也不会进入 renderer/webview。
WHATSAPP_CLOUD_ENABLED=false
# 显式锁定 Graph API 版本，升级前先按 Meta changelog 与官方 collection 回归。
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_META_APP_ID=
WHATSAPP_META_CONFIG_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# 公开 HTTPS origin，例如 https://imhub.example.com；Webhook 与 Embedded Signup 共用。
WHATSAPP_PUBLIC_BASE_URL=
# 生成方式：openssl rand -base64 32
WHATSAPP_SECRET_MASTER_KEY=
PORT=4000
